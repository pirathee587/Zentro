    "/api/v1/tracking/{trackingRef}/stream": {
      "get": {
        "operationId": "streamPublicTracking",
        "summary": "Subscribe to tracking events",
        "description": "Server-sent events; gateway sets Cache-Control: no-cache and X-Accel-Buffering: no. Public: anonymous and human access; SERVICE-only tokens are denied.",
        "tags": [
          "S4"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
