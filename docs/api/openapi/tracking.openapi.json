  "paths": {
    "/api/v1/reports/deliveries/daily": {
      "get": {
        "operationId": "getDailyDeliveryReport",
        "summary": "Read daily delivery metrics",
        "description": "Required inclusive Asia/Colombo dates, from <= to, at most 92 days, to no later than today. Uses business event occurred_at via tracking.reporting_day(). Every requested day is returned in ascending order. Existing view values, including active on intervening days, are preserved; absent view days have zero counts and null successRate. Invalid dates/ranges return 400 with fieldErrors naming from or to. Date filters only; CSV export deferred. Allowed roles: DISPATCHER.",
        "tags": [
          "S4"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyDeliveryReport"
                }
              }
            },
            "headers": {
              "X-Correlation-Id": {
                "description": "Accepted correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or invalid parameter",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Correlation-Id": {
                "description": "Accepted correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Correlation-Id": {
                "description": "Accepted correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated caller lacks an allowed role or resource permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Correlation-Id": {
                "description": "Accepted correlation identifier.",
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "from filter or pagination parameter.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "to filter or pagination parameter.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "description": "Optional correlation identifier: 1-128 ASCII letters, digits, dots, underscores or hyphens, starting with a letter or digit. Missing, duplicate or invalid values are replaced with a UUID; the accepted ID is returned in the response header.",
