                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              },
              "Cache-Control": {
                "description": "Response header emitted by the operation.",
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              },
              "X-Accel-Buffering": {
                "description": "Response header emitted by the operation.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or invalid parameter",
