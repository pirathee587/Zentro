GATEWAY_PORT=8080
# Docker: http://keycloak:8180/realms/zentro  |  host run: http://localhost:8180/realms/zentro
JWT_ISSUER_URI=http://keycloak:8180/realms/zentro
JWT_JWKS_URI=
JWT_AUDIENCE=zentro-api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Docker service hostnames (use http://localhost:808x when running on the host)
S1_URI=http://identity-partner-service:8081
S2_URI=http://parcel-pricing-service:8082
S3_URI=http://dispatch-courier-service:8083
S4_URI=http://tracking-reporting-service:8084
S5_URI=http://notification-integration-service:8085
GATEWAY_CONNECT_TIMEOUT_MS=1000
GATEWAY_RESPONSE_TIMEOUT=30s
GATEWAY_TRACKING_RESPONSE_TIMEOUT_MS=3600000
RATE_LIMIT_TRACKING_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=300
TRUST_X_FORWARDED_FOR=false
