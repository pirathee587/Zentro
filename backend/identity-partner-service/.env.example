SERVER_PORT=8081
# PostgreSQL JDBC URL. Put real host/credentials in your local .env only.
DB_URL=jdbc:postgresql://<db-host>:5432/<db-name>?sslmode=require
DB_USER=<db-user>
DB_PASSWORD=<db-password>
# Docker: http://keycloak:8180/realms/zentro  |  host run: http://localhost:8180/realms/zentro
JWT_ISSUER_URI=http://keycloak:8180/realms/zentro
JWT_AUDIENCE=zentro-api
