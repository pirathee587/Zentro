SERVER_PORT=8081
# Supabase shared pooler. Keep the password in your local .env file only.
DB_URL=jdbc:postgresql://db.example.invalid:5432/identity_db
DB_USER=replace_with_identity_runtime_user
DB_PASSWORD=replace_with_unique_identity_password
# Docker: http://keycloak:8180/realms/zentro  |  host run: http://localhost:8180/realms/zentro
JWT_ISSUER_URI=http://localhost:8180/realms/zentro
JWT_AUDIENCE=zentro-api
# Optional shared-token authentication; empty leaves the existing JWT path available.
INTERNAL_SERVICE_TOKEN=
