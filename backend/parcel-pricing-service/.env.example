SERVER_PORT=8082
# Supabase shared pooler. Keep the password in your local .env file only.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.qhlirfnhiwiqcumtwhtd
DB_PASSWORD=replace-with-your-supabase-database-password
JWT_ISSUER_URI=http://localhost:8180/realms/zentro
JWT_AUDIENCE=zentro-api
# Kafka and outbox publishing (S2 parcel events). Publishing is off unless enabled.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OUTBOX_PUBLISHER_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_SEND_TIMEOUT_MS=5000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=300000
OUTBOX_STUCK_THRESHOLD_MS=300000
OUTBOX_TOPIC_PARTITIONS=3
OUTBOX_TOPIC_REPLICAS=1
