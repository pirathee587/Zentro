SERVER_PORT=8084
# Supabase shared pooler. Keep the password in your local .env file only.
DB_URL=jdbc:postgresql://db.example.invalid:5432/tracking_reporting_db
DB_USER=replace_with_tracking_reporting_runtime_user
DB_PASSWORD=replace_with_unique_tracking_reporting_password
JWT_ISSUER_URI=http://localhost:8180/realms/zentro
JWT_AUDIENCE=zentro-api
SERVICE_TOKEN_URI=http://localhost:8180/realms/zentro/protocol/openid-connect/token
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_ENABLED=false

# Internal service clients use gRPC on the Compose network.
PARCEL_GRPC_HOST=zentro-parcel-pricing-service
PARCEL_GRPC_PORT=9082
DISPATCH_GRPC_HOST=zentro-dispatch-courier-service
DISPATCH_GRPC_PORT=9083
SERVICE_CLIENT_ID=zentro-tracking-service
SERVICE_CLIENT_SECRET=
