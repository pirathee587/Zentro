SERVER_PORT=8083
# Supabase shared pooler. Keep the password in your local .env file only.
DB_URL=jdbc:postgresql://db.example.invalid:5432/dispatch_courier_db
DB_USER=replace_with_dispatch_courier_runtime_user
DB_PASSWORD=replace_with_unique_dispatch_courier_password
JWT_ISSUER_URI=http://localhost:8180/realms/zentro
JWT_AUDIENCE=zentro-api
# S2 is called directly over gRPC; the POD client credential is service-specific.
IDENTITY_GRPC_HOST=zentro-identity-partner-service
IDENTITY_GRPC_PORT=9081
PARCEL_GRPC_HOST=zentro-parcel-pricing-service
PARCEL_GRPC_PORT=9082
POD_TOKEN_URI=http://localhost:8180/realms/zentro/protocol/openid-connect/token
POD_CLIENT_ID=zentro-dispatch-service
POD_CLIENT_SECRET=
# Application-side Flyway must stay disabled for shared Supabase (historical V5 lineage).
# Never set SPRING_FLYWAY_ENABLED=true or SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false here.
# Shared migrations: separately authorized runbook only (docs/development/s3-flyway-safety.md).
SPRING_FLYWAY_ENABLED=false
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
POD_WORKER_ENABLED=true
POD_POLL_INTERVAL_MS=2000
POD_MAX_ATTEMPTS=8
