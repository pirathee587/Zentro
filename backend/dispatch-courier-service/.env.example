SERVER_PORT=8083
# Supabase shared pooler. Keep the password in your local .env file only.
DB_URL=jdbc:postgresql://db.example.invalid:5432/dispatch_courier_db
DB_USER=replace_with_dispatch_courier_runtime_user
DB_PASSWORD=replace_with_unique_dispatch_courier_password
JWT_ISSUER_URI=http://localhost:8180/realms/zentro
JWT_AUDIENCE=zentro-api
# Existing Identity dispatcher REST APIs; forwarded dispatcher bearer authentication.
IDENTITY_BASE_URL=http://localhost:8081
# S2 is called directly with a confidential SERVICE client, never the courier token.
PARCEL_BASE_URL=http://localhost:8082
POD_TOKEN_URI=http://localhost:8180/realms/zentro/protocol/openid-connect/token
POD_CLIENT_ID=
POD_CLIENT_SECRET=
POD_WORKER_ENABLED=true
POD_POLL_INTERVAL_MS=2000
POD_MAX_ATTEMPTS=8
