SERVER_PORT=8085
# Supabase shared pooler. Keep the password in your local .env file only.
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.gextxpppufuubsoeyqdx
DB_PASSWORD=replace-with-your-supabase-database-password
JWT_ISSUER_URI=http://localhost:8180/realms/zentro
JWT_AUDIENCE=zentro-api
# Kafka consumer for parcel events. Off unless enabled.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-integration-service
NOTIFICATIONS_CONSUMER_ENABLED=false
# Notification retries and the mock SMS sender (fail mode: none | always | first-attempt).
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_POLL_MS=5000
NOTIFICATION_RETRY_BASE_DELAY_MS=5000
NOTIFICATION_RETRY_MAX_DELAY_MS=600000
NOTIFICATION_MOCK_FAIL_MODE=none
NOTIFICATION_HEALTH_FAILED_WINDOW_MINUTES=60
NOTIFICATION_HEALTH_STUCK_PENDING_MINUTES=10
