SERVER_PORT=8085
# Supabase shared pooler. Keep the password in your local .env file only.
DB_URL=jdbc:postgresql://db.example.invalid:5432/notification_integration_db
DB_USER=replace_with_notification_integration_runtime_user
DB_PASSWORD=replace_with_unique_notification_integration_password
JWT_ISSUER_URI=http://localhost:8180/realms/zentro
JWT_AUDIENCE=zentro-api
SERVICE_TOKEN_URI=http://localhost:8180/realms/zentro/protocol/openid-connect/token
# Kafka consumer for parcel events. Off unless enabled.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-integration-service
NOTIFICATIONS_CONSUMER_ENABLED=false
# Notification retries and the mock SMS sender (fail mode: none | always | first-attempt | timeout | throttled | permanent).
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_POLL_MS=5000
NOTIFICATION_RETRY_BASE_DELAY_MS=5000
NOTIFICATION_RETRY_MAX_DELAY_MS=600000
NOTIFICATION_MOCK_FAIL_MODE=none
NOTIFICATION_HEALTH_FAILED_WINDOW_MINUTES=60
NOTIFICATION_HEALTH_STUCK_PENDING_MINUTES=10
# Internal service clients use gRPC on the Compose network.
IDENTITY_GRPC_HOST=zentro-identity-partner-service
IDENTITY_GRPC_PORT=9081
PARCEL_GRPC_HOST=zentro-parcel-pricing-service
PARCEL_GRPC_PORT=9082
SERVICE_CLIENT_ID=zentro-notification-service
SERVICE_CLIENT_SECRET=
# Merchant webhooks. Off unless enabled. WEBHOOK_SECRET_KEY: base64 of 32 random bytes
# (for example: openssl rand -base64 32); keep the real value in your local .env only.
WEBHOOKS_ENABLED=false
WEBHOOKS_ALLOW_INSECURE_LOCAL=false
WEBHOOK_SECRET_KEY=
WEBHOOK_CONSUMER_GROUP=merchant-webhooks
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_POLL_MS=5000
WEBHOOK_RETRY_BASE_DELAY_MS=10000
WEBHOOK_RETRY_MULTIPLIER=2.0
WEBHOOK_RETRY_MAX_DELAY_MS=1800000
WEBHOOK_CONNECT_TIMEOUT_MS=2000
WEBHOOK_READ_TIMEOUT_MS=5000
WEBHOOK_HEALTH_FAILED_WINDOW_MINUTES=60
WEBHOOK_HEALTH_STUCK_MINUTES=10

# Customer assistant (backend only). Empty key leaves S5 running with a configuration fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ASSISTANT_CONNECT_TIMEOUT_MS=1000
ASSISTANT_READ_TIMEOUT_MS=15000
ASSISTANT_TOOL_TIMEOUT_MS=3000

# Persistent in-app inbox consumer (prepared only; enable after approved migrations/topic provisioning).
INBOX_CONSUMER_ENABLED=false
INBOX_CONSUMER_GROUP=in-app-inbox-v1
DISPATCH_GRPC_HOST=localhost
DISPATCH_GRPC_PORT=9083
