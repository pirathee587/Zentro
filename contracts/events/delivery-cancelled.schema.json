    "eventType": {"const": "delivery.cancelled"},
    "payload": {
      "type": "object",
      "required": ["action", "oldCourierId", "actorSubject"],
      "properties": {
        "action": {"const": "CANCELLED"},
        "oldCourierId": {"type": "string", "format": "uuid"},
        "newCourierId": {"type": ["string", "null"], "format": "uuid"},
        "actorSubject": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
