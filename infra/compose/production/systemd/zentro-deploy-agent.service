[Unit]
Description=Zentro pull deployment agent (applies approved GitHub releases)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/zentro/bin/deploy-agent
User=root
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
