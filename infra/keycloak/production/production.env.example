# TEMPLATE ONLY. Copy to .env.production ON THE SERVER (cp production.env.example .env.production), fill in, then: chmod 600 .env.production
# Never commit the filled file. No values here are real.

# Public HTTPS address of the single Zentro Keycloak (becomes the token issuer base).
KC_PUBLIC_HOST=auth.example.com
KC_PUBLIC_URL=https://auth.example.com

# Let's Encrypt registration / expiry notices.
ACME_EMAIL=owner@example.com

# Networks allowed to open the Keycloak admin console (space-separated CIDRs), e.g. your office/home IP.
ADMIN_ALLOW_CIDRS=203.0.113.10/32

# Shared Supabase Keycloak database (session pooler, port 5432, schema "keycloak").
KC_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
KC_DB_USERNAME=
KC_DB_PASSWORD=

# Optional, first start only, if nobody knows the shared master-realm admin password:
# run `docker compose run --rm keycloak bootstrap-admin user --username <temp> --password:env TEMP_ADMIN_PW`
# once, create a named permanent admin in the console, then delete the temporary one.
