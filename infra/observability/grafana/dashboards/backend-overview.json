{
  "title": "Zentro Backend Overview",
  "uid": "zentro-backend-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Scrape availability", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [{ "expr": "up{job=\"zentro-backend\"}", "legendFormat": "{{service}}", "refId": "A" }] },
    { "id": 2, "type": "timeseries", "title": "HTTP 5xx rate", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [{ "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "{{service}}", "refId": "A" }] },
    { "id": 3, "type": "timeseries", "title": "JVM heap utilization", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [{ "expr": "jvm_memory_used_bytes{area=\"heap\"} / jvm_memory_max_bytes{area=\"heap\"}", "legendFormat": "{{service}}", "refId": "A" }] }
  ]
}
