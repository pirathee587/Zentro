# Development Compose host binding. The same variable applies to every Compose file.
BIND_ADDRESS=127.0.0.1
# If Windows blocks 8080, set this to an available port such as 18080.
# Compose also uses this port for the frontend API URL unless VITE_API_BASE_URL is set.
GATEWAY_HOST_PORT=8080
# A non-loopback binding is an explicit operator choice; see docs/security/production-configuration.md.
